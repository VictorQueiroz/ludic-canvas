{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "ludic-canvas": ["./src/index.ts"],
      "ludic-canvas/core": ["./src/core.ts"],
      "ludic-canvas/native": ["./src/native.ts"]
    }
  },
  "include": ["src", "docs", "tests", "examples", "*.config.ts"]
}
